{
  "name": "mermaid-unicode",
  "version": "0.1.0",
  "description": "在 Node CLI 与浏览器中将 Mermaid 子集渲染为 Unicode 字符图",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./web": {
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    }
  },
  "bin": {
    "mermaid-unicode": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test",
    "example": "node examples/render.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WtecHtec/WorkNotes.git",
    "directory": "Cli-Mermaid"
  },
  "keywords": [
    "mermaid",
    "unicode",
    "cli",
    "flowchart",
    "state-diagram",
    "class-diagram",
    "sequence-diagram",
    "er-diagram",
    "ansi",
    "ascii-art"
  ],
  "author": "Wtechtec",
  "bugs": {
    "url": "https://github.com/WtecHtec/WorkNotes/issues"
  },
  "homepage": "https://github.com/WtecHtec/WorkNotes/tree/master/Cli-Mermaid#readme",
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
